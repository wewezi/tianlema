<view class="premium-page add-page">
  <view class="add-container">
    <!-- Type Selector -->
    <view class="form-type-selector">
      <view class="type-tab {{formType === 'out' ? 'active out' : ''}}" bindtap="switchFormType" data-type="out">支出 (付出)</view>
      <view class="type-tab {{formType === 'none' ? 'active none' : ''}}" bindtap="switchFormType" data-type="none">波动 (日常)</view>
      <view class="type-tab {{formType === 'in' ? 'active in' : ''}}" bindtap="switchFormType" data-type="in">收入 (收获)</view>
    </view>

    <!-- Content Card -->
    <view class="add-card">
      <!-- Target Field -->
      <view class="field animate-in" style="animation-delay: 0.1s;">
        <text class="label">
          {{formType === 'out' ? '这份眷恋投向何处？' : (formType === 'in' ? '谁给予了这份温暖？' : '这阵涟漪因谁而起？')}}
        </text>
        <input class="premium-ipt" placeholder="{{formType === 'none' ? '那个魂牵梦绕的名字...' : '输入他/她的名字...'}}" value="{{target}}" bindinput="onTarget" placeholder-style="color:#cbd5e1;" />
        
        <!-- Recent Names -->
        <view class="recent-names" wx:if="{{recentNames.length > 0}}">
          <view class="name-tag" wx:for="{{recentNames}}" wx:key="*this" bindtap="pickName" data-v="{{item}}">
            {{item}}
          </view>
        </view>
      </view>

      <!-- Action Tags -->
      <view class="field animate-in" style="animation-delay: 0.2s;">
        <text class="label">
          {{formType === 'out' ? '当时的情感轨迹' : (formType === 'in' ? '互动的温馨点滴' : '内心的情感投射')}}
        </text>
        <view class="tags-cloud {{formType}}">
          <view 
            class="tag-token {{selectedAction === item ? 'active' : ''}}" 
            wx:for="{{actions}}" 
            wx:key="*this" 
            bindtap="pickAction" 
            data-v="{{item}}"
          >{{item}}</view>
          <view class="tag-token custom {{customAction ? 'active' : ''}}" bindtap="openCustomModal">
            {{customAction || '+ 自定义'}}
          </view>
        </view>
      </view>

      <!-- Amount & Intensity -->
      <view class="field animate-in" style="animation-delay: 0.3s;">
        <text class="label">
          {{formType === 'out' ? '付出金额 (我出钱 ¥)' : (formType === 'in' ? '回血金额 (进钱包 ¥)' : '折合价值 (非现金 ¥)')}}
        </text>
        <input class="premium-ipt" type="digit" placeholder="0.00" value="{{amount}}" bindinput="onAmount" placeholder-style="color:#cbd5e1;" />
      </view>

      <view class="field animate-in" style="animation-delay: 0.4s;">
        <text class="label">记录心情</text>
        <view class="mood-selector">
          <view 
            class="mood-item {{simpIndex === index + 1 ? 'active' : ''}}" 
            wx:for="{{moods}}" 
            wx:key="text"
            bindtap="pickMood"
            data-v="{{index + 1}}"
          >
            <view class="mood-emoji">{{item.emoji}}</view>
            <view class="mood-text">{{item.text}}</view>
          </view>
        </view>
      </view>

      <!-- Images -->
      <view class="field animate-in" style="animation-delay: 0.5s;">
        <text class="label">捕捉瞬间 (相册)</text>
        <view class="image-grid">
          <view class="image-item" wx:for="{{images}}" wx:key="*this">
            <image class="preview-img" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-src="{{item}}" />
            <view class="img-delete" bindtap="deleteImage" data-idx="{{index}}">
              <icon type="clear" size="16" color="#fff" />
            </view>
          </view>
          <view class="image-add" bindtap="chooseImage" wx:if="{{images.length < 9}}">
            <image src="data:image/svg+xml;base64," style="width: 48rpx; height: 48rpx;" />
          </view>
        </view>
      </view>

      <!-- Note -->
      <view class="field animate-in" style="animation-delay: 0.6s;">
        <text class="label">内心独白</text>
        <textarea class="premium-txa" placeholder="记录下那一刻不可言说的思绪..." value="{{note}}" bindinput="onNote" maxlength="200" placeholder-style="color:#cbd5e1;" />
      </view>
    </view>

    <view class="btn-submit-wrap animate-in" style="animation-delay: 0.6s;">
      <button class="btn-submit-premium" bindtap="submit">{{formType === 'out' ? '尘封入卷' : (formType === 'in' ? '珍藏于心' : '镌刻涟漪')}}</button>
    </view>
  </view>
</view>
