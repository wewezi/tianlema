.page {
  min-height: 100vh;
  background: #fafafa;
}

.header {
  background: #fff;
  padding: 40rpx 32rpx 32rpx;
  border-bottom: 1rpx solid #eee;
}
.h-title { font-size: 40rpx; font-weight: 900; color: #1a1a1a; display: block; letter-spacing: -1rpx; }
.h-sub { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }

.body { padding: 24rpx 28rpx; }

.ach-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 12rpx;
}
.ach-item {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx 12rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  border: 1rpx solid #eee;
}
.ach-item:active { opacity: 0.7; }
.ach-item.locked {
  opacity: 0.25;
  filter: grayscale(1);
}
.ach-icon { font-size: 44rpx; }
.ach-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.ach-desc {
  font-size: 18rpx;
  color: #888;
  line-height: 1.3;
}
