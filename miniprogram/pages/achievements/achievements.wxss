.demumu-page {
  min-height: 100vh;
  background: var(--c-bg);
  padding: 80rpx 40rpx;
  box-sizing: border-box;
}

.d-header {
  text-align: center;
  margin-bottom: 60rpx;
}
.d-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--c-text);
  display: block;
}
.d-sub {
  font-size: 26rpx;
  color: var(--c-sub);
  margin-top: 16rpx;
  display: block;
}

.card-block {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.02);
}

.d-ach-list {
  display: flex;
  flex-direction: column;
}
.d-ach-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
  transition: opacity 0.3s;
}
.d-ach-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.d-ach-item.locked {
  opacity: 0.4;
}
.d-ach-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  padding-right: 20rpx;
}
.d-ach-title {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--c-text);
}
.d-ach-desc {
  font-size: 24rpx;
  color: var(--c-sub);
}
.d-ach-status {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--c-pri);
}
.locked .d-ach-status {
  color: var(--c-hint);
}
