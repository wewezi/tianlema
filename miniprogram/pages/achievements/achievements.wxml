<view class="demumu-page">
  <view class="d-header">
    <text class="d-title">成就档案</text>
    <text class="d-sub">已解锁 {{unlockedCount}} / {{totalCount}}</text>
  </view>

  <view class="d-body card-block">
    <view class="d-ach-list">
      <view class="d-ach-item {{item.unlocked ? '' : 'locked'}}" wx:for="{{achievements}}" wx:key="title">
        <view class="d-ach-main">
          <text class="d-ach-title">{{item.title}}</text>
          <text class="d-ach-desc">{{item.desc}}</text>
        </view>
        <text class="d-ach-status">{{item.unlocked ? '已达成' : '未解锁'}}</text>
      </view>
    </view>
  </view>
</view>
