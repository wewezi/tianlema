<view class="demumu-page">
  <view class="d-header">
    <text class="d-title">排行榜</text>
    <text class="d-sub">你 · 第 {{yourRank}} 名 · {{yourScore}} 分</text>
  </view>

  <view class="d-body card-block">
    <view class="d-rank-list">
      <view class="d-rank-item {{item.isYou ? 'you' : ''}}" wx:for="{{ranking}}" wx:key="rank">
        <text class="d-rank-pos">{{item.rank}}</text>
        <text class="d-rank-name">{{item.name}}</text>
        <text class="d-rank-score">{{item.scoreDisplay}}</text>
      </view>
    </view>
  </view>
</view>
