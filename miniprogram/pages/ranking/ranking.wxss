.demumu-page {
  min-height: 100vh;
  background: var(--c-bg);
  padding: 80rpx 40rpx;
  box-sizing: border-box;
}

.d-header {
  text-align: center;
  margin-bottom: 60rpx;
}
.d-title {
  font-size: 48rpx;
  font-weight: 800;
  color: var(--c-text);
  display: block;
}
.d-sub {
  font-size: 26rpx;
  color: var(--c-sub);
  margin-top: 16rpx;
  display: block;
}

.card-block {
  background: #fff;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.02);
}

.d-rank-list {
  display: flex;
  flex-direction: column;
}
.d-rank-item {
  display: flex;
  padding: 30rpx 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
  align-items: center;
}
.d-rank-item:last-child {
  border-bottom: none;
}
.d-rank-item.you {
  font-weight: 900;
  color: var(--c-pri);
}
.d-rank-pos {
  width: 60rpx;
  font-size: 28rpx;
  font-weight: 900;
  color: var(--c-hint);
}
.d-rank-item.you .d-rank-pos { color: var(--c-pri); }
.d-rank-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
}
.d-rank-score {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
}
