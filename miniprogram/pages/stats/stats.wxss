.premium-page {
  min-height: 100vh;
  background: var(--c-bg, #f7f3f5);
  padding: 40rpx 40rpx 100rpx;
  box-sizing: border-box;
}

.profile-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 0;
  display: flex;
  flex-direction: column;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.03);
  margin-bottom: 60rpx;
  position: relative;
  overflow: hidden;
}

.profile-main {
  display: flex;
  align-items: center;
  padding: 30rpx 40rpx 30rpx;
  width: 100%;
  box-sizing: border-box;
}
.avatar-btn {
  width: 130rpx !important;
  height: 130rpx !important;
  border-radius: 50% !important;
  padding: 0 !important;
  margin: 0;
  background: var(--c-pri-pale, #ffe4e6);
  border: 4rpx solid #fff;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.05);
  display: flex !important;
  justify-content: center;
  align-items: center;
  flex-shrink: 0;
  overflow: hidden;
}
.avatar-btn::after { display: none; }
.avatar-img, .avatar-placeholder { width: 100%; height: 100%; border-radius: 50%; }

.profile-info {
  flex: 1;
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  min-width: 0;
}

.nick-input {
  text-align: left;
  font-size: 34rpx;
  font-weight: 800;
  color: var(--c-text, #333);
  width: 100%;
}

.rank-row {
  display: flex;
  align-items: center;
  margin-top: 10rpx;
  gap: 16rpx;
}

.rank-badge.small {
  background: var(--c-pri, #ff4d6a);
  color: #fff;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 800;
  white-space: nowrap;
}

.rank-next {
  font-size: 20rpx;
  color: var(--c-sub, #999);
  font-weight: 600;
}

.progress-container {
  width: 100%;
  height: 10rpx;
  background: #f1f3f5;
  border-radius: 5rpx;
  margin-top: 20rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(to right, var(--c-pri, #ff4d6a), #ff8fa3);
  border-radius: 5rpx;
  transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  width: 100%;
  border-top: 1rpx solid #f8f9fa;
  background: #fafbfc;
}
.stat-box {
  flex: 1;
  padding: 30rpx 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
  border-right: 1rpx solid #f8f9fa;
}
.stat-box:last-child {
  border-right: none;
}
.stat-v {
  font-size: 32rpx;
  font-weight: 900;
  color: var(--c-text, #333);
  margin-bottom: 6rpx;
  text-align: center;
}
.stat-l {
  font-size: 20rpx;
  color: var(--c-sub, #999);
  font-weight: 600;
  text-align: center;
  white-space: nowrap;
}

.section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: var(--c-text, #333);
  margin-bottom: 24rpx;
  display: block;
  padding-left: 10rpx;
}
.board-section {
  margin-bottom: 60rpx;
}
.board-card {
  background: #fff;
  border-radius: 30rpx;
  padding: 20rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}
.b-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.b-row:last-child { border-bottom: none; }
.b-left {
  display: flex;
  align-items: baseline;
  gap: 20rpx;
}
.b-idx {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--c-hint, #bbb);
}
.b-name {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--c-text, #333);
}
.b-count {
  font-size: 30rpx;
  font-weight: 800;
  color: var(--c-pri, #ff4d6a);
}

.tools-section {
  margin-bottom: 40rpx;
}
.tools-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}
.tool-btn {
  background: #fff;
  border-radius: 30rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  transition: transform 0.2s;
}
.tool-btn:active {
  transform: scale(0.95);
}
.tb-icon {
  width: 80rpx; height: 80rpx;
  background: #f8f9fa;
  border-radius: 50%;
  display: flex; justify-content: center; align-items: center;
  font-size: 36rpx;
  margin-bottom: 16rpx;
}
.tb-text {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-text, #333);
}
