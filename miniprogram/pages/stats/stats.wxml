<view class="premium-page">
  <view class="profile-card">
    <view class="profile-main">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{avatarUrl}}" class="avatar-img" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="avatar-placeholder">
          <image src="data:image/svg+xml;base64," style="width: 80rpx; height: 80rpx;" />
        </view>
      </button>

      <view class="profile-info">
        <input type="nickname" class="nick-input" placeholder="点击设置代号" value="{{nickname}}" bindchange="onNicknameChange" />
        <view class="rank-row">
          <view class="rank-badge small">
            <text>{{rankInfo.title}}</text>
          </view>
          <text class="rank-next" wx:if="{{rankInfo.next}}">{{rankInfo.next}}</text>
        </view>
        <view class="progress-container">
          <view class="progress-bar" style="width: {{rankPercent}}%"></view>
        </view>
      </view>
    </view>

    <view class="stats-grid">
      <view class="stat-box">
        <text class="stat-v">{{totalEvents}}</text>
        <text class="stat-l">深情时刻</text>
      </view>
      <view class="stat-box">
        <text class="stat-v">¥{{totalAmount}}</text>
        <text class="stat-l">累计付出</text>
      </view>
      <view class="stat-box">
        <text class="stat-v">{{avgSimp}}</text>
        <text class="stat-l">平均分</text>
      </view>
      <view class="stat-box">
        <text class="stat-v">{{targetCount}}</text>
        <text class="stat-l">眷恋对象</text>
      </view>
    </view>
  </view>

  <view class="board-section" wx:if="{{topTargets.length > 0}}">
    <text class="section-title">深情守候榜</text>
    <view class="board-card">
      <view class="b-row" wx:for="{{topTargets}}" wx:key="name">
        <view class="b-left">
          <text class="b-idx">0{{index+1}}</text>
          <text class="b-name">{{item.name}}</text>
        </view>
        <view class="b-right">
          <text class="b-count">{{item.count}}次</text>
        </view>
      </view>
    </view>
  </view>

  <view class="board-section" wx:if="{{topActions.length > 0}}">
    <text class="section-title">心动轨迹</text>
    <view class="board-card">
      <view class="b-row" wx:for="{{topActions}}" wx:key="name">
        <view class="b-left">
          <text class="b-idx">0{{index+1}}</text>
          <text class="b-name">{{item.name}}</text>
        </view>
        <view class="b-right">
          <text class="b-count">{{item.count}}次</text>
        </view>
      </view>
    </view>
  </view>

  <view class="tools-section">
    <text class="section-title">工具面板</text>
    <view class="tools-grid">
      <view class="tool-btn" bindtap="goAchievements">
        <view class="tb-icon">
          <image src="data:image/svg+xml;base64," style="width: 48rpx; height: 48rpx;" />
        </view>
        <text class="tb-text">成就档案</text>
      </view>
      <view class="tool-btn" bindtap="goQuiz">
        <view class="tb-icon">
          <image src="data:image/svg+xml;base64," style="width: 48rpx; height: 48rpx;" />
        </view>
        <text class="tb-text">情感测评</text>
      </view>
      <view class="tool-btn" bindtap="exportData">
        <view class="tb-icon">
          <image src="data:image/svg+xml;base64," style="width: 48rpx; height: 48rpx;" />
        </view>
        <text class="tb-text">导出报告</text>
      </view>
      <view class="tool-btn" bindtap="clearAllData" style="background: #fff1f2;">
        <view class="tb-icon" style="background: #ffe4e6;">
          <image src="data:image/svg+xml;base64," style="width: 48rpx; height: 48rpx;" />
        </view>
        <text class="tb-text" style="color: #ef4444;">销毁记录</text>
      </view>
    </view>
  </view>
</view>
