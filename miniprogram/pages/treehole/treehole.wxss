.page {
  min-height: 100vh;
  background: #f7f3f5;
  padding-bottom: 180rpx;
}

/* Header */
.th-header {
  background: linear-gradient(160deg, #6b7280 0%, #4b5563 100%);
  padding: 48rpx 36rpx 52rpx;
  border-radius: 0 0 48rpx 48rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.th-title {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
}
.th-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
}

/* List */
.th-list {
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.th-empty {
  text-align: center;
  padding: 100rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}
.th-empty-icon { font-size: 80rpx; }
.th-empty-text { font-size: 26rpx; color: #6b7280; }

/* Card */
.th-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.025);
}
.th-content {
  font-size: 28rpx;
  color: #374151;
  line-height: 1.7;
  display: block;
  margin-bottom: 24rpx;
}
.th-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.th-time {
  font-size: 22rpx;
  color: #9ca3af;
}
.th-votes {
  display: flex;
  gap: 16rpx;
}
.th-vote {
  font-size: 24rpx;
  color: #6b7280;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #f3f4f6;
  font-weight: 600;
}
.th-vote:active {
  transform: scale(0.95);
}
.th-vote.deserve {
  background: rgba(245,158,11,0.08);
  color: #d97706;
}

/* FAB */
.th-fab {
  position: fixed;
  right: 36rpx;
  bottom: calc(60rpx + env(safe-area-inset-bottom));
  width: 108rpx;
  height: 108rpx;
  border-radius: 54rpx;
  background: linear-gradient(135deg, #6b7280, #4b5563);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 36rpx rgba(75,85,99,0.4);
  z-index: 80;
}
.th-fab:active { transform: scale(0.88); }
.th-fab-icon { font-size: 44rpx; }

/* Sheet */
.th-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.35);
  backdrop-filter: blur(6px);
  z-index: 10000;
}
.th-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 40rpx 40rpx 0 0;
  padding: 32rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 10001;
  box-shadow: 0 -8rpx 40rpx rgba(0,0,0,0.06);
  animation: sheetUp 0.35s ease;
}
@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.th-sheet-bar {
  width: 64rpx; height: 8rpx;
  background: #e5e7eb; border-radius: 4rpx;
  margin: 0 auto 28rpx;
}
.th-sheet-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #16192c;
  margin-bottom: 24rpx;
  display: block;
}
.th-textarea {
  width: 100%;
  height: 240rpx;
  background: #f9fafb;
  border: 2rpx solid #f3f4f6;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #16192c;
  box-sizing: border-box;
  line-height: 1.6;
}
.th-textarea:focus {
  background: #fff;
  border-color: #6b7280;
}
.th-char-count {
  text-align: right;
  font-size: 22rpx;
  color: #6b7280;
  margin: 8rpx 0 20rpx;
}
.th-submit {
  background: linear-gradient(135deg, #6b7280, #4b5563);
  color: #fff;
  text-align: center;
  padding: 26rpx;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 28rpx rgba(75,85,99,0.22);
}
.th-submit:active { transform: scale(0.98); }

/* Skeleton */
.th-skeleton {
  display: flex; flex-direction: column; gap: 20rpx;
}
.th-skel-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex; flex-direction: column; gap: 16rpx;
}
.th-skel-line {
  height: 24rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}
.th-skel-line.long { width: 90%; }
.th-skel-line.medium { width: 60%; }
.th-skel-line.short { width: 35%; }
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
