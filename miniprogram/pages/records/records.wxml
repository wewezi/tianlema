<view class="page">
  <!-- Header -->
  <view class="header">
    <text class="h-title">付出历史</text>
    <text class="h-sub">回首那些卑微的足迹</text>
    <view class="h-stats" wx:if="{{totalCount > 0}}">
      <view class="h-stat">
        <text class="h-num">{{totalAmount}}</text>
        <text class="h-label">元 · 总花费</text>
      </view>
      <view class="h-div"></view>
      <view class="h-stat">
        <text class="h-num">{{totalCount}}</text>
        <text class="h-label">次 · 总记录</text>
      </view>
    </view>
  </view>

  <!-- Body -->
  <view class="body">
    <view wx:if="{{totalCount === 0}}" class="empty">
      <text class="empty-icon">🦴</text>
      <text class="empty-text">两袖清风，还没开始记录</text>
    </view>

    <view wx:else>
      <view class="group" wx:for="{{groups}}" wx:key="label" wx:for-item="group">
        <view class="group-head">
          <text class="group-label">{{group.label}}</text>
          <text class="group-count">{{group.records.length}} 条</text>
        </view>
        <view class="list">
          <view class="swipe-cell" wx:for="{{group.records}}" wx:key="id" wx:for-item="record">
            <view class="swipe-content" style="transform: translateX({{record.swipeX || 0}}px)"
              data-gi="{{index}}" data-gk="{{group.label}}"
              catchtouchstart="onSwipeStart"
              catchtouchmove="onSwipeMove"
              catchtouchend="onSwipeEnd"
            >
              <view class="item">
                <view class="item-icon" style="background: {{record.color}}1f; color: {{record.color}};">
                  <text>{{record.icon}}</text>
                </view>
                <view class="item-body">
                  <view class="item-row1">
                    <text class="item-action">{{record.action}}</text>
                    <text class="item-target" wx:if="{{record.target}}">@{{record.target}}</text>
                  </view>
                  <text class="item-meta">{{record.date}} · {{record.note || '无备注'}}</text>
                  <view class="item-stars">
                    <text wx:for="{{[1,2,3,4,5]}}" wx:key="*this" class="s {{index < record.simpIndex ? 'on' : ''}}">★</text>
                  </view>
                </view>
                <view class="item-end">
                  <text class="item-amt" wx:if="{{record.amount > 0}}">¥{{record.amount}}</text>
                </view>
              </view>
            </view>
            <view class="swipe-del" data-id="{{record.id}}" bindtap="deleteItem">
              <text>删除</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
