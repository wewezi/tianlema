.page {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #fafafa;
}

/* ===== Header ===== */
.header {
  background: #fff;
  padding: 40rpx 32rpx 32rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  flex-direction: column;
}
.h-title { font-size: 40rpx; font-weight: 900; color: #1a1a1a; letter-spacing: -1rpx; }
.h-sub { font-size: 22rpx; color: #999; margin-top: 4rpx; }

.h-stats {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  background: #fafafa;
  border-radius: 12rpx;
  padding: 20rpx 0;
  border: 1rpx solid #eee;
}
.h-stat {
  flex: 1; text-align: center;
  display: flex; flex-direction: column; gap: 2rpx;
}
.h-num { font-size: 40rpx; font-weight: 900; color: #1a1a1a; }
.h-label { font-size: 20rpx; color: #999; font-weight: 400; }
.h-div { width: 1rpx; height: 44rpx; background: #eee; }

/* ===== Body ===== */
.body { padding: 24rpx 28rpx 0; }

/* Empty */
.empty {
  text-align: center;
  padding: 80rpx 0;
  display: flex; flex-direction: column; align-items: center; gap: 12rpx;
}
.empty-icon { font-size: 56rpx; }
.empty-text { font-size: 24rpx; color: #888; }

/* List */
.list {
  display: flex; flex-direction: column;
  background: #fff;
  border-radius: 12rpx;
  border: 1rpx solid #eee;
  overflow: hidden;
}

.swipe-cell {
  position: relative;
  overflow: hidden;
  border-bottom: 1rpx solid #f0f0f0;
}
.swipe-cell:last-child { border-bottom: none; }

.swipe-content {
  position: relative;
  z-index: 2;
  background: #fff;
  transition: transform 0.2s ease;
  padding: 0 24rpx;
}

.swipe-del {
  position: absolute;
  right: 0; top: 0; bottom: 0;
  width: 65px;
  background: #ef4444;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  z-index: 1;
}

.item {
  padding: 20rpx 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.item-icon {
  width: 56rpx; height: 56rpx;
  border-radius: 12rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

/* Date groups */
.group { margin-bottom: 24rpx; }
.group-head {
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 4rpx 12rpx;
}
.group-label { font-size: 24rpx; font-weight: 600; color: #666; }
.group-count { font-size: 20rpx; color: #888; font-weight: 400; }

.item-body { flex: 1; display: flex; flex-direction: column; gap: 4rpx; }

.item-row1 { display: flex; align-items: center; gap: 8rpx; }
.item-action { font-size: 28rpx; font-weight: 600; color: #1a1a1a; }
.item-target {
  font-size: 20rpx; font-weight: 600; color: #ff4d6a;
  background: #fff0f3;
  padding: 2rpx 12rpx; border-radius: 6rpx;
}

.item-meta { font-size: 20rpx; color: #888; }

.item-stars { display: flex; gap: 4rpx; margin-top: 2rpx; }
.s { font-size: 18rpx; color: #ddd; }
.s.on { color: #f59e0b; }

.item-end {
  display: flex; flex-direction: column;
  align-items: flex-end; gap: 8rpx;
  flex-shrink: 0;
}
.item-amt { font-size: 28rpx; font-weight: 800; color: #1a1a1a; }
