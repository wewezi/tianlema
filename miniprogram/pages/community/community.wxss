.premium-page {
  min-height: 100vh;
  background: var(--c-bg, #f7f3f5);
  padding: 40rpx 40rpx 100rpx;
  box-sizing: border-box;
}

.quote-banner {
  background: linear-gradient(135deg, var(--c-pri, #ff4d6a), #ff8fa3);
  border-radius: 40rpx;
  padding: 30rpx 40rpx;
  position: relative;
  overflow: hidden;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(255, 77, 106, 0.15);
}

.qb-content {
  position: relative;
  z-index: 2;
  display: flex;
  flex-direction: column;
}

.qb-title {
  font-size: 20rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.8);
  text-transform: uppercase;
  letter-spacing: 4rpx;
  margin-bottom: 10rpx;
}

.qb-text {
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
  color: #fff;
  margin-bottom: 20rpx;
}

.qb-author {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 600;
  align-self: flex-end;
}

.qb-decoration .circle {
  position: absolute;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.qb-decoration .c1 {
  width: 160rpx;
  height: 160rpx;
  top: -80rpx;
  right: -40rpx;
}

.qb-decoration .c2 {
  width: 100rpx;
  height: 100rpx;
  bottom: -30rpx;
  left: 10%;
}

.rank-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 50rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.03);
  margin-bottom: 60rpx;
}

/* Tabs Switcher */
.comm-tabs-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}
.comm-tabs {
  display: flex;
  background: #fff;
  border-radius: 40rpx;
  padding: 8rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
}
.c-tab {
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--c-sub, #999);
  border-radius: 32rpx;
  transition: all 0.2s;
}
.c-tab.active {
  background: var(--c-pri, #ff4d6a);
  color: #fff;
  box-shadow: 0 8rpx 20rpx var(--c-pri-pale, #ffe4e6);
}


.rc-list {
  display: flex;
  flex-direction: column;
}
.rc-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.rc-item:last-child { border-bottom: none; padding-bottom: 0; }
.rc-left { display: flex; align-items: baseline; gap: 24rpx; }
.rc-pos { font-size: 30rpx; font-weight: 900; color: var(--c-hint, #bbb); }
.rc-name { font-size: 32rpx; font-weight: 800; color: var(--c-text, #333); }
.rc-item.you .rc-pos { color: var(--c-pri, #ff4d6a); }
.rc-item.you .rc-name { color: var(--c-pri, #ff4d6a); }
.rc-score { font-size: 30rpx; font-weight: 800; color: var(--c-text, #333); }

.feed-section {
  display: flex;
  flex-direction: column;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}
.post-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.03);
}
.post-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}
.post-user-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.post-avatar {
  width: 60rpx; height: 60rpx;
  background: var(--c-pri-pale, #ffe4e6);
  border-radius: 50%;
  display: flex; justify-content: center; align-items: center;
  overflow: hidden;
}
.post-avatar image {
  width: 100%;
  height: 100%;
}
.post-avatar-placeholder {
  font-size: 26rpx;
  font-weight: 800;
  color: var(--c-pri, #ff4d6a);
}
.post-user { font-size: 28rpx; font-weight: 800; color: var(--c-text, #333); }
.post-top-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.post-time { font-size: 24rpx; color: var(--c-hint, #bbb); }
.post-delete {
  font-size: 24rpx;
  color: #ef4444;
  background: rgba(239, 68, 68, 0.05);
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
}
.post-content {
  font-size: 32rpx;
  line-height: 1.6;
  color: var(--c-text, #333);
  display: block;
  margin-bottom: 40rpx;
}
/* Feed Images */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 20rpx;
}
.post-img {
  width: calc((100% - 20rpx) / 3);
  height: 200rpx;
  border-radius: 12rpx;
}
.post-img.large {
  width: 100%;
  height: 400rpx;
}

/* Post Form Images */
.post-image-upload {
  display: flex;
  flex-wrap: wrap;
  gap: 15rpx;
  padding: 20rpx 40rpx;
}
.p-image-item {
  position: relative;
  width: 120rpx;
  height: 120rpx;
}
.p-image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.p-image-delete {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #ff4d6a;
  color: #fff;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}
.p-image-add {
  width: 120rpx;
  height: 120rpx;
  border: 2rpx dashed #cbd5e1;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #94a3b8;
  font-size: 40rpx;
}

.post-actions {
  display: flex;
  gap: 20rpx;
}
.post-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 30rpx;
  background: #f8f9fa;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--c-sub, #999);
}
.post-btn.bad { color: var(--c-text, #333); }
.btn-num { font-weight: 800; }

/* FAB */
.fab-btn {
  position: fixed;
  right: 50rpx;
  bottom: calc(180rpx + env(safe-area-inset-bottom));
  width: 120rpx; height: 120rpx;
  background: var(--c-pri, #ff4d6a);
  border-radius: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-shadow: 0 16rpx 40rpx var(--c-pri-pale, #ffe4e6);
  z-index: 80;
  transition: transform 0.2s;
}
.fab-btn:active { transform: scale(0.9); }
.fab-icon { font-size: 60rpx; font-weight: 300; color: #fff; margin-top: -6rpx; }

/* Bottom Sheet */
.sheet-overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.3);
  backdrop-filter: blur(4px);
  z-index: 10000;
  animation: fadeIn 0.3s ease;
}
.post-sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 50rpx 50rpx 0 0;
  padding: 40rpx 50rpx calc(40rpx + env(safe-area-inset-bottom));
  z-index: 10001;
  animation: sheetUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-shadow: 0 -10rpx 50rpx rgba(0,0,0,0.05);
}
.sheet-handle {
  width: 80rpx; height: 10rpx;
  background: rgba(0,0,0,0.1);
  border-radius: 10rpx;
  margin: 0 auto 50rpx;
}
.sheet-input {
  width: 100%;
  height: 240rpx;
  font-size: 34rpx;
  line-height: 1.5;
  color: var(--c-text, #333);
}
.sheet-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 40rpx;
}
.sheet-count { font-size: 26rpx; color: var(--c-hint, #bbb); font-weight: 500; }
.sheet-submit {
  background: var(--c-pri, #ff4d6a);
  color: #fff;
  padding: 20rpx 50rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 30rpx var(--c-pri-pale, #ffe4e6);
}
.sheet-submit:active { opacity: 0.8; }

@keyframes sheetUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
