<view class="premium-page">
  <view class="quote-banner" bindtap="copyDaily">
    <view class="qb-content">
      <text class="qb-title">每日深情</text>
      <text class="qb-text">{{dailyQuote.text}}</text>
      <text class="qb-author">— {{dailyQuote.author}}</text>
    </view>
    <view class="qb-decoration">
      <view class="circle c1"></view>
      <view class="circle c2"></view>
    </view>
  </view>
 
  <view class="comm-tabs-wrapper">
    <view class="comm-tabs">
      <view class="c-tab {{currentTab === 'feed' ? 'active' : ''}}" bindtap="switchTab" data-tab="feed">深情树洞</view>
      <view class="c-tab {{currentTab === 'ranking' ? 'active' : ''}}" bindtap="switchTab" data-tab="ranking">付出排行</view>
    </view>
  </view>

  <!-- Feed Tab -->
  <view wx:if="{{currentTab === 'feed'}}">
    <view class="feed-section" wx:if="{{!loading}}">

      <view class="feed-list">
        <view class="post-card" wx:for="{{confessionsPreview}}" wx:key="id">
          <view class="post-top">
            <view class="post-user-info">
              <view class="post-avatar">
                <image wx:if="{{item.avatar}}" src="{{item.avatar}}" mode="aspectFill" />
                <view wx:else class="post-avatar-placeholder">{{item.nickname[0]}}</view>
              </view>
              <text class="post-user">{{item.nickname}}</text>
            </view>
            <view class="post-top-right">
              <text class="post-time">{{item.timeAgo}}</text>
              <text wx:if="{{item.userId === currentUserId}}" class="post-delete" bindtap="deletePost" data-id="{{item.id}}">删除</text>
            </view>
          </view>
          <text class="post-content">{{item.content}}</text>
          
          <view class="post-images" wx:if="{{item.images && item.images.length > 0}}">
            <image 
              class="post-img {{item.images.length === 1 ? 'large' : ''}}" 
              wx:for="{{item.images}}" 
              wx:for-item="img" 
              wx:key="*this" 
              src="{{img}}" 
              mode="aspectFill" 
              bindtap="previewFeedImage" 
              data-src="{{img}}" 
              data-urls="{{item.images}}"
            />
          </view>
          <view class="post-actions">
            <view class="post-btn" data-id="{{item.id}}" bindtap="voteSympathy">
              <text>感同身受</text><text class="btn-num">{{item.sympathy}}</text>
            </view>
            <view class="post-btn bad" data-id="{{item.id}}" bindtap="voteDeserved">
              <text>祝你幸福</text><text class="btn-num">{{item.deserved}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- Ranking Tab -->
  <view wx:if="{{currentTab === 'ranking'}}">
    <view class="rank-card" wx:if="{{!loading}}">
      <view class="rc-list">
        <view class="rc-item {{item.isYou ? 'you' : ''}}" wx:for="{{ranking}}" wx:key="name">
          <view class="rc-left">
            <text class="rc-pos">{{item.rank < 10 ? '0' + item.rank : item.rank}}</text>
            <text class="rc-name">{{item.name}}</text>
          </view>
          <text class="rc-score">{{item.scoreDisplay}}分</text>
        </view>
      </view>
    </view>
  </view>
</view>

<view class="fab-btn" bindtap="openPostForm">
  <text class="fab-icon">+</text>
</view>

<view wx:if="{{showPostForm}}" class="sheet-overlay" bindtap="closePostForm"></view>
<view wx:if="{{showPostForm}}" class="post-sheet">
  <view class="sheet-handle"></view>
  <textarea class="sheet-input" placeholder="写给某人的信..." value="{{postInput}}" bindinput="onPostInput" maxlength="500" auto-focus show-confirm-bar="{{false}}" />
  
  <view class="post-image-upload">
    <view class="p-image-item" wx:for="{{postImages}}" wx:key="*this">
      <image src="{{item}}" mode="aspectFill" bindtap="previewPostImage" data-src="{{item}}" />
      <view class="p-image-delete" bindtap="deleteImage" data-idx="{{index}}">×</view>
    </view>
    <view class="p-image-add" bindtap="chooseImage" wx:if="{{postImages.length < 9}}">+</view>
  </view>

  <view class="sheet-footer">
    <text class="sheet-count">{{postInput.length}}/500</text>
    <view class="sheet-submit" bindtap="submitPost">发布</view>
  </view>
</view>
