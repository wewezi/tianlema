.index-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: calc(env(safe-area-inset-top) + 60rpx) 40rpx calc(200rpx + env(safe-area-inset-bottom));
  justify-content: space-between;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

.index-header {
  margin-top: 40rpx;
  z-index: 2;
}
.status-glass {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20px);
  padding: 40rpx;
  border-radius: 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.03);
  text-align: center;
}
.status-main {
  font-size: 36rpx;
  font-weight: 800;
  color: var(--c-text);
  margin-bottom: 8rpx;
}
.status-sub {
  font-size: 24rpx;
  color: var(--c-sub);
  font-weight: 600;
}

.center-container {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 2;
}

.giant-btn-wrapper {
  position: relative;
  width: 460rpx;
  height: 460rpx;
}
.giant-btn {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 77, 106, 0.9), rgba(255, 143, 163, 0.8));
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 20rpx 60rpx rgba(255, 77, 106, 0.4), inset 0 2rpx 2rpx rgba(255,255,255,0.3);
  position: relative;
  z-index: 10;
  transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  overflow: hidden;
  backdrop-filter: blur(5px);
}
.btn-gloss {
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 50%;
  background: linear-gradient(to bottom, rgba(255,255,255,0.4), rgba(255,255,255,0));
  border-radius: 50% 50% 100% 100% / 100% 100% 0% 0%;
  pointer-events: none;
}
.giant-btn-inner {
  text-align: center;
}
.btn-text {
  font-size: 52rpx;
  font-weight: 900;
  color: #fff;
  letter-spacing: 8rpx;
  text-shadow: 0 4rpx 15rpx rgba(0,0,0,0.15);
  margin-right: -8rpx;
  white-space: nowrap;
}

/* Pulse Waves */
.pulse-wave {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  border-radius: 50%;
  background: var(--c-pri, #ff4d6a);
  opacity: 0;
  z-index: 1;
}
.w1 { animation: pulseWave 4s infinite cubic-bezier(0.36, 0.11, 0.89, 0.32); }
.w2 { animation: pulseWave 4s infinite cubic-bezier(0.36, 0.11, 0.89, 0.32) 2s; }

@keyframes pulseWave {
  0% { transform: scale(1); opacity: 0.3; }
  100% { transform: scale(1.6); opacity: 0; }
}

.btn-decoration {
  position: absolute;
  top: -30rpx; left: -30rpx; right: -30rpx; bottom: -30rpx;
  border: 2rpx dashed var(--c-pri-pale, #ffe4e6);
  border-radius: 50%;
  z-index: 5;
  animation: rotate 20s linear infinite;
  opacity: 0.6;
}
@keyframes rotate {
  from { transform: rotate(0); }
  to { transform: rotate(360deg); }
}

.giant-btn:active {
  transform: scale(0.92);
  box-shadow: 0 10rpx 20rpx rgba(255, 77, 106, 0.2);
}

.mission-section {
  width: 100%;
}
.mission-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 30rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.03);
}
.mission-card.done {
  background: #f8fafc;
  opacity: 0.8;
}
.m-label {
  font-size: 22rpx;
  font-weight: 800;
  color: var(--c-pri, #ff4d6a);
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  display: block;
}
.m-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text);
}

.check-box {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid var(--c-pri-pale, #ffe4e6);
  border-radius: 50%;
  display: flex;
  justify-content: center;
  align-items: center;
  transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.check-box.checked {
  background: var(--c-pri, #ff4d6a);
  border-color: var(--c-pri, #ff4d6a);
  transform: scale(1.1);
}

/* Narrative Form Styles */
.overlay {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
  z-index: 10000;
  opacity: 0;
  pointer-events: none;
  transition: all 0.4s ease;
}
.overlay.show {
  opacity: 1;
  pointer-events: auto;
}

.sheet {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  background: #fff;
  border-radius: 60rpx 60rpx 0 0;
  padding: 32rpx 0 calc(40rpx + env(safe-area-inset-bottom));
  z-index: 10001;
  max-height: 90vh;
  overflow-y: auto;
  transform: translateY(100%);
  transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
  box-shadow: 0 -20rpx 80rpx rgba(0,0,0,0.1);
}
.sheet.show {
  transform: translateY(0);
}
.sheet-content {
  padding: 0 50rpx;
}

.sheet-bar {
  width: 80rpx; height: 8rpx;
  background: #f1f5f9; border-radius: 4rpx;
  margin: 0 auto 40rpx;
}
/* Form Type Selector */
.form-type-selector {
  display: flex;
  background: #f1f5f9;
  padding: 8rpx;
  border-radius: 20rpx;
  margin-bottom: 30rpx;
}
.type-tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  font-weight: 600;
  color: #64748b;
  transition: all 0.3s ease;
  border-radius: 16rpx;
}
.type-tab.active {
  background: #fff;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.05);
}
.type-tab.active.out { color: var(--c-pri); }
.type-tab.active.in { color: #10b981; }
.type-tab.active.none { color: #8b5cf6; }

.sheet-title {
  display: block;
  font-size: 36rpx;
  font-weight: 800;
  color: #1e293b;
  margin-bottom: 40rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.field { margin-bottom: 50rpx; }
.label {
  font-size: 26rpx; font-weight: 800; color: var(--c-sub);
  margin-bottom: 24rpx; display: block;
  letter-spacing: 1rpx;
}

.premium-ipt {
  border: none;
  border-bottom: 2rpx solid #f1f5f9;
  padding: 20rpx 0;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--c-text);
  width: 100%;
  transition: all 0.3s;
}
.premium-ipt.mini {
  font-size: 28rpx;
  margin-top: 20rpx;
}
.premium-ipt:focus {
  border-bottom-color: var(--c-pri);
}

.premium-txa {
  background: #f8fafc;
  border-radius: 30rpx;
  padding: 30rpx;
  height: 200rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--c-text);
  width: 100%;
  box-sizing: border-box;
}

.tags-cloud {
  display: flex; flex-wrap: wrap; gap: 20rpx;
}
.tag-token {
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx; font-weight: 700;
  background: #f8fafc;
  color: #64748b;
  transition: all 0.2s;
}
.tag-token.active {
  background: var(--c-pri-pale);
  color: var(--c-pri);
}

.heart-rating {
  display: flex; gap: 16rpx;
  padding: 10rpx 0;
}
.heart-item {
  width: 48rpx; height: 48rpx;
  color: #f1f5f9;
  transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
}
.heart-item.on {
  color: var(--c-pri);
  transform: scale(1.2);
}
.heart-icon {
  width: 100%; height: 100%;
}

.row-flex { display: flex; gap: 40rpx; }
.f1 { flex: 1; }

.btn-submit-wrap {
  margin-top: 60rpx;
}
.btn-submit-premium {
  background: linear-gradient(135deg, var(--c-pri-light), var(--c-pri));
  color: #fff;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex; justify-content: center; align-items: center;
  font-size: 32rpx; font-weight: 900;
  box-shadow: 0 10rpx 40rpx rgba(255, 77, 106, 0.3);
  border: none;
}
.btn-submit-premium:active {
  transform: scale(0.97);
  opacity: 0.9;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
