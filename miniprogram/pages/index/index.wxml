<view class="premium-page index-page">
  <view class="index-header">
    <view class="status-glass">
      <view class="status-main">{{weekTotal > 0 ? '本周已深情守候 ' + weekTotal + ' 次' : '此刻内心平静'}}</view>
      <view class="status-sub" wx:if="{{weekTotal > 0}}">累计心意价值 ¥{{weekAmount}}</view>
    </view>
  </view>

  <view class="center-container">
    <view class="giant-btn-wrapper">
      <view class="pulse-wave w1"></view>
      <view class="pulse-wave w2"></view>
      <view class="giant-btn" bindtap="openForm" hover-class="giant-btn-active">
        <view class="giant-btn-inner">
          <text class="btn-text">记录深情</text>
        </view>
        <view class="btn-gloss"></view>
      </view>
      <view class="btn-decoration"></view>
    </view>
  </view>

  <view class="mission-section">
    <view class="mission-card {{challengeDone ? 'done' : ''}}" bindtap="toggleChallenge">
      <view class="m-left">
        <text class="m-label">今日深情任务</text>
        <text class="m-text">{{challengeDone ? '今日修行已圆满' : challengeText}}</text>
      </view>
      <view class="m-right">
        <view class="check-box {{challengeDone ? 'checked' : ''}}">
          <icon wx:if="{{challengeDone}}" type="success_no_circle" color="#fff" size="14" />
        </view>
      </view>
    </view>
  </view>
</view>
