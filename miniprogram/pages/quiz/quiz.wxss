.quiz-page {
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

.quiz-progress-bar {
  position: fixed;
  top: 0; left: 0; right: 0;
  height: 6rpx;
  background: rgba(255, 77, 106, 0.1);
  z-index: 100;
}
.qp-inner {
  height: 100%;
  background: var(--c-pri, #ff4d6a);
  transition: width 0.3s ease;
  box-shadow: 0 0 10rpx var(--c-pri, #ff4d6a);
}

.q-screen {
  flex: 1;
  display: flex;
  flex-direction: column;
  animation: fadeIn 0.4s ease;
}

.start-screen {
  justify-content: center;
  align-items: center;
  text-align: center;
  padding-bottom: 100rpx;
}

.q-hero {
  margin-bottom: 80rpx;
}
.q-icon-wrap {
  width: 160rpx; height: 160rpx;
  background: #fff;
  border-radius: 50%;
  display: flex; justify-content: center; align-items: center;
  margin: 0 auto 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(255, 77, 106, 0.1);
}
.q-title {
  font-size: 48rpx;
  font-weight: 900;
  color: var(--c-text, #333);
  display: block;
  margin-bottom: 20rpx;
}
.q-subtitle {
  font-size: 28rpx;
  color: var(--c-sub, #999);
  font-weight: 500;
}

.q-card {
  background: #fff;
  border-radius: 40rpx;
  padding: 60rpx 50rpx;
  box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.03);
  margin-bottom: 40rpx;
  position: relative;
  margin-top: 60rpx;
}
.q-number {
  position: absolute;
  top: -30rpx; left: 40rpx;
  background: var(--c-pri, #ff4d6a);
  color: #fff;
  padding: 8rpx 30rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 20rpx var(--c-pri-pale, #ffe4e6);
}
.q-text {
  font-size: 36rpx;
  line-height: 1.6;
  font-weight: 800;
  color: var(--c-text, #333);
}

.q-options {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.q-opt {
  background: #fff;
  padding: 36rpx 40rpx;
  border-radius: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.02);
  transition: all 0.2s;
  border: 2rpx solid transparent;
}
.q-opt-active {
  background: var(--c-pri-pale, #ffe4e6);
  border-color: var(--c-pri, #ff4d6a);
  transform: scale(0.98);
}
.q-opt-text {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--c-text, #333);
}
.q-opt-arrow {
  color: var(--c-pri, #ff4d6a);
  font-weight: 800;
  opacity: 0.3;
}

.result-screen {
  align-items: center;
  justify-content: center;
}
.res-card {
  background: #fff;
  border-radius: 50rpx;
  padding: 80rpx 60rpx;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.04);
  margin-bottom: 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.res-label {
  font-size: 24rpx;
  font-weight: 800;
  color: var(--c-sub, #999);
  text-transform: uppercase;
  letter-spacing: 4rpx;
  margin-bottom: 20rpx;
}
.res-score {
  font-size: 120rpx;
  font-weight: 900;
  color: var(--c-text, #333);
  line-height: 1;
  margin-bottom: 40rpx;
}
.res-divider {
  width: 80rpx; height: 6rpx;
  background: #f0f0f0;
  border-radius: 3rpx;
  margin-bottom: 40rpx;
}
.res-level {
  font-size: 44rpx;
  font-weight: 900;
  margin-bottom: 20rpx;
}
.res-desc {
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--c-sub, #666);
  font-weight: 500;
}

.q-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.q-btn {
  height: 100rpx;
  border-radius: 50rpx;
  display: flex; justify-content: center; align-items: center;
  font-size: 32rpx;
  font-weight: 800;
  transition: all 0.2s;
}
.q-btn.main {
  background: var(--c-pri, #ff4d6a);
  color: #fff;
  box-shadow: 0 10rpx 30rpx var(--c-pri-pale, #ffe4e6);
}
.q-btn.sub {
  background: #fff;
  color: var(--c-sub, #999);
  border: 2rpx solid #eee;
}
.q-btn:active { transform: scale(0.96); opacity: 0.9; }

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(20rpx); }
  to { opacity: 1; transform: translateY(0); }
}
