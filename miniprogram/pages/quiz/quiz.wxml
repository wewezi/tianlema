<view class="premium-page quiz-page">
  <!-- Progress Bar -->
  <view class="quiz-progress-bar" wx:if="{{state === 'playing'}}">
    <view class="qp-inner" style="width: {{((currentIndex + 1) / totalQuestions) * 100}}%"></view>
  </view>

  <!-- Start Screen -->
  <view wx:if="{{state === 'start'}}" class="q-screen start-screen">
    <view class="q-hero">
      <view class="q-icon-wrap">
        <image src="data:image/svg+xml;base64," style="width: 80rpx; height: 80rpx;" />
      </view>
      <text class="q-title">深度共情测评</text>
      <text class="q-subtitle">测一测你的“深情”处于哪一档位</text>
    </view>
    <view class="q-actions">
      <view class="q-btn main" bindtap="startQuiz">开启修行</view>
      <view class="q-btn sub" bindtap="goBack">暂不参与</view>
    </view>
  </view>

  <!-- Playing Screen -->
  <view wx:elif="{{state === 'playing'}}" class="q-screen play-screen">
    <view class="q-card">
      <view class="q-number">Q{{currentIndex + 1}}</view>
      <text class="q-text">{{currentQ.q}}</text>
    </view>
    <view class="q-options">
      <view class="q-opt" wx:for="{{currentQ.options}}" wx:key="text" data-score="{{item.score}}" bindtap="pickOption" hover-class="q-opt-active">
        <text class="q-opt-text">{{item.text}}</text>
        <view class="q-opt-arrow">></view>
      </view>
    </view>
  </view>

  <!-- Result Screen -->
  <view wx:elif="{{state === 'result'}}" class="q-screen result-screen">
    <view class="res-card">
      <text class="res-label">测评得分</text>
      <text class="res-score">{{totalScore}}</text>
      <view class="res-divider"></view>
      <text class="res-level" style="color: {{result.color}}">{{result.title}}</text>
      <text class="res-desc">{{result.desc}}</text>
    </view>
    <view class="q-actions">
      <view class="q-btn main" bindtap="shareResult">同步至档案</view>
      <view class="q-btn sub" bindtap="retry">重新评估</view>
      <view class="q-btn sub" bindtap="goBack">返回主页</view>
    </view>
  </view>
</view>
